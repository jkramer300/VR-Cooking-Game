      m_Calls: []
  m_text: "Die Verwendung eines Deckels beim Erhitzen von Lebensmitteln in einem
    Topf oder einer Pfanne reduziert den W\xE4rmeverlust, indem W\xE4rme und Dampf
    eingeschlossen werden. Dadurch k\xF6nnen Lebensmittel effizienter garen und der
    Energieverbrauch wird in der Regel gesenkt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
