--- !u!114 &83273767
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 83273764}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c2c25eb66fcb1334b974ef246177ecad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Recipe
  numberOfIngredients: 0
  ingredients:
  - Carrot
  - Millet
  - Egg
  - Leek
  quantity:
  - 1
  - 1
  - 1
  - 1
  - 1
  numberOfTools: 0
  tools:
  - Brett
  - Messer
  time: []
  ovenMode: 0
  ovenDegree: 0
  ovenTime: 0
  steps:
  - "Wasche das Gem\xFCse."
  - "Schneide das Gem\xFCse"
  - "Gib \xD6l in die Pfanne."
  - "Gib das Gem\xFCse in die Pfanne."
  - "Brate das Gem\xFCse an"
  - Wasche die Hirse.
  - Gib die Hirse in die Pfanne.
  - "Gib Gem\xFCsebr\xFChe in die Pfanne."
  - Gib ein Ei in die Pfanne.
  - Koche alles 10 Minuten lang.
  - Teig zubereiten
  - "Brate die Hirseb\xE4llchen."
  instructions:
  - "Wasche das Gem\xFCse."
  - "Schneide das Gem\xFCse und gib es in die orange Sch\xFCssel. \u2159 Lauch, 1
    Karotte"
  - "Gib \xD6l in die Pfanne."
  - "Gib das Gem\xFCse in die Pfanne."
  - "Brate das Gem\xFCse bei mittlerer Hitze (Stufe 2), bis es weich ist."
  - "Wasche die Goldhirse in einer Sch\xFCssel. Gie\xDFe anschlie\xDFend das Wasser
    aus der Sch\xFCssel ab. (60 g Hirse)"
  - Gib die Hirse in die Pfanne.
  - "Gib Gem\xFCsebr\xFChe in die Pfanne."
  - "Schlage das Ei auf und sch\xE4le es mit der A-Taste. Gib es anschlie\xDFend
    in die Pfanne."
  - Koche alles 10 Minuten lang (stelle den Herd auf Stufe 2).
  - Bereite den Teig zu
  - "Forme aus dem Teig B\xE4llchen, indem du den Teig festh\xE4ltst und die A-Taste
    dr\xFCckst. Brate sie anschlie\xDFend."
  numberOfInstructions: 11
